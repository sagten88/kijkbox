#!/bin/bash
# Kijkbox bijwerken. Draait als root in de container.
#
#   kijkbox-update check     nieuwe versie zoeken (en installeren als automatisch aan staat)
#   kijkbox-update install   nieuwste versie installeren zodra niemand kijkt
#   kijkbox-update request   verzoek van de website afhandelen (check of install)
#   kijkbox-update status    laten zien wat er geïnstalleerd is en wat de nieuwste is
#
# Alleen versies (tags) met een geldige handtekening van de uitgever worden geïnstalleerd.
# De sleutel om die te controleren staat in /etc/kijkbox/allowed_signers.
set -euo pipefail

SRC=/opt/kijkbox-src
APP=/opt/kijkbox
DATA=/var/lib/kijkbox
ETC=/etc/kijkbox
STATUS="$DATA/update-status.json"
REQUEST="$DATA/update-request"
SETTINGS="$DATA/update-config.json"
LOCK=/run/kijkbox-update.lock
IDLE_SECONDS=30
MAX_WAIT_SECONDS=$((6 * 3600))

PUBLIC_REPO=https://github.com/sagten88/kijkbox.git

# Nooit om een wachtwoord vragen: dit draait zonder iemand erbij.
export GIT_TERMINAL_PROMPT=0
# Oudere installaties halen updates via SSH met een eigen sleutel (deploy key). Zolang ze nog niet
# zijn overgestapt op de openbare repository, blijft dat werken.
if [ -f "$ETC/deploy_key" ]; then
  export GIT_SSH_COMMAND="ssh -i $ETC/deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$ETC/known_hosts"
fi
git_() { git -C "$SRC" -c gpg.format=ssh -c "gpg.ssh.allowedSignersFile=$ETC/allowed_signers" -c advice.detachedHead=false "$@"; }

log() { echo "kijkbox-update: $*"; }

# Overstappen van SSH (met sleutel) naar https zodra de openbare repository bereikbaar is.
# Daarna is de sleutel niet meer nodig. De handtekening op elke versie blijft wel verplicht.
use_public_repo() {
  local url
  url="$(git -C "$SRC" remote get-url origin 2>/dev/null || true)"
  case "$url" in https://*) return 0 ;; esac
  if git -c credential.helper= ls-remote --exit-code --tags "$PUBLIC_REPO" >/dev/null 2>&1; then
    git -C "$SRC" remote set-url origin "$PUBLIC_REPO"
    git -C "$SRC" config --unset core.sshCommand 2>/dev/null || true
    log "updates komen voortaan via https uit de openbare repository"
  fi
}

installed_version() { node -p "require('$APP/package.json').version" 2>/dev/null || echo "0.0.0"; }

# Status voor de website (Instellingen > Updates). JSON via node, zodat tekens netjes ontsnapt worden.
write_status() { # state latest message notes
  STATE="$1" LATEST="$2" MESSAGE="$3" NOTES="$4" node -e '
    const fs = require("fs");
    const out = { state: process.env.STATE, latest: process.env.LATEST || null, message: process.env.MESSAGE || "",
      notes: process.env.NOTES || "", checkedAt: Date.now() };
    fs.writeFileSync(process.argv[1] + ".tmp", JSON.stringify(out));
    fs.renameSync(process.argv[1] + ".tmp", process.argv[1]);
  ' "$STATUS"
  chown kijkbox:kijkbox "$STATUS" 2>/dev/null || true
}

auto_enabled() { node -p "Boolean(JSON.parse(require('fs').readFileSync('$SETTINGS','utf8')).auto)" 2>/dev/null | grep -qx true; }

# Beschrijving van één versie: de titel ("Kijkbox 1.0.3") en de regels eronder, zonder lege regels.
tag_notes() { git_ tag -l --format='%(contents:subject)%0a%(contents:body)' "$1" | sed '/^[[:space:]]*$/d'; }

# Nieuwste versie met een geldige handtekening. Zet LATEST_TAG en LATEST, en in NOTES de
# beschrijvingen van álle versies die nieuwer zijn dan de geïnstalleerde (nieuwste eerst). Wie een
# paar versies heeft overgeslagen, ziet zo in één keer wat er allemaal veranderd is.
find_latest() {
  use_public_repo
  git_ fetch --quiet --force --prune --tags origin
  local current
  current="$(installed_version)"
  LATEST_TAG=""
  NOTES=""
  for tag in $(git_ tag -l 'v[0-9]*' --sort=-v:refname); do
    if ! git_ verify-tag "$tag" >/dev/null 2>&1; then
      log "versie $tag overgeslagen: geen geldige handtekening"
      continue
    fi
    [ -n "$LATEST_TAG" ] || LATEST_TAG="$tag"
    newer "${tag#v}" "$current" || break
    NOTES="${NOTES:+$NOTES$'\n\n'}$(tag_notes "$tag")"
  done
  [ -n "$LATEST_TAG" ] || { LATEST=""; return 1; }
  LATEST="${LATEST_TAG#v}"
}

# Na een geslaagde update: wat er nieuw is, voor de melding in de website.
write_whats_new() { # version notes
  VERSION="$1" NOTES="$2" node -e '
    const fs = require("fs");
    const out = { version: process.env.VERSION, notes: process.env.NOTES || "", at: Date.now() };
    fs.writeFileSync(process.argv[1] + ".tmp", JSON.stringify(out));
    fs.renameSync(process.argv[1] + ".tmp", process.argv[1]);
  ' "$DATA/whats-new.json"
  chown kijkbox:kijkbox "$DATA/whats-new.json" 2>/dev/null || true
}

newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }

wait_until_idle() {
  local waited=0 idle=0
  # De beheerder heeft bevestigd dat het nu mag, ook al kijkt er iemand.
  [ "${FORCE:-0}" = 1 ] && return 0
  while [ "$idle" -lt "$IDLE_SECONDS" ]; do
    # Tijdens het wachten alsnog "nu installeren" gekozen? Dan meteen door.
    if [ "$(cat "$REQUEST" 2>/dev/null || true)" = "install-now" ]; then
      rm -f "$REQUEST"
      log "beheerder koos: nu installeren, ook al wordt er gekeken"
      return 0
    fi
    if pgrep -x ffmpeg >/dev/null; then idle=0; else idle=$((idle + 5)); fi
    sleep 5
    waited=$((waited + 5))
    [ "$waited" -lt "$MAX_WAIT_SECONDS" ] || return 1
  done
}

install_latest() {
  local current
  current="$(installed_version)"
  if ! find_latest; then write_status error "" "Geen versie met een geldige handtekening gevonden." ""; return 1; fi
  if ! newer "$LATEST" "$current"; then
    write_status idle "$LATEST" "" "$NOTES"
    log "versie $current is al de nieuwste"
    return 0
  fi
  write_status waiting "$LATEST" "" "$NOTES"
  log "wacht tot niemand kijkt om $LATEST te installeren"
  if ! wait_until_idle; then write_status error "$LATEST" "Er werd te lang gekeken; de update volgt later." "$NOTES"; return 1; fi

  write_status installing "$LATEST" "" "$NOTES"
  git_ checkout --quiet --force "$LATEST_TAG"
  git_ verify-tag "$LATEST_TAG" >/dev/null 2>&1 || { write_status error "$LATEST" "Handtekening klopt niet." "$NOTES"; return 1; }

  # Nieuwe versie naast de oude opbouwen; pas omwisselen als alles klaar is.
  rm -rf "$APP.new"
  mkdir -p "$APP.new"
  cp -a "$SRC/server" "$SRC/public" "$SRC/deploy" "$SRC/package.json" "$SRC/package-lock.json" "$APP.new/"
  if ! (cd "$APP.new" && npm ci --omit=dev --no-audit --no-fund --loglevel=error); then
    rm -rf "$APP.new"
    write_status error "$LATEST" "Onderdelen installeren mislukte." "$NOTES"
    return 1
  fi
  chown -R root:root "$APP.new"

  rm -rf "$APP.old"
  mv "$APP" "$APP.old"
  mv "$APP.new" "$APP"
  install_system_files
  systemctl restart kijkbox
  sleep 8
  if ! systemctl is-active --quiet kijkbox; then
    log "nieuwe versie start niet; terug naar $current"
    rm -rf "$APP.failed"
    mv "$APP" "$APP.failed"
    mv "$APP.old" "$APP"
    install_system_files
    systemctl restart kijkbox
    write_status error "$LATEST" "Versie $LATEST startte niet; versie $current is teruggezet." "$NOTES"
    return 1
  fi
  write_whats_new "$LATEST" "$NOTES"
  write_status idle "$LATEST" "" ""
  log "versie $LATEST geïnstalleerd"
}

# Systemd-bestanden en dit programma zelf bijwerken vanuit de geïnstalleerde versie.
install_system_files() {
  install -m 0644 "$APP"/deploy/systemd/*.service "$APP"/deploy/systemd/*.timer "$APP"/deploy/systemd/*.path /etc/systemd/system/
  install -m 0755 "$APP/deploy/kijkbox-update" /usr/local/bin/kijkbox-update
  systemctl daemon-reload
}

check() {
  if find_latest; then
    if newer "$LATEST" "$(installed_version)" && [ "${1:-}" = "auto" ] && auto_enabled; then
      install_latest
    else
      write_status idle "$LATEST" "" "$NOTES"
      log "geïnstalleerd: $(installed_version), nieuwste: $LATEST"
    fi
  else
    write_status error "" "Kon geen versie ophalen. Heeft de server internet, en is GitHub bereikbaar?" ""
    return 1
  fi
}

main() {
  exec 9>"$LOCK"
  if [ "${1:-}" = "request" ]; then
    # Een verzoek van de website wacht tot een lopende update klaar is. Zou het meteen stoppen, dan
    # bleef het verzoekbestand liggen en startte systemd dit steeds opnieuw, tot het werd uitgeschakeld.
    # (Wordt intussen "nu installeren" gekozen, dan pakt de lopende update dat zelf op.)
    if ! flock -w 25000 9; then
      log "lopende update duurt te lang; verzoek vervalt"
      rm -f "$REQUEST"
      exit 0
    fi
  else
    flock -n 9 || { log "er loopt al een update"; exit 0; }
  fi
  case "${1:-status}" in
    check) write_status checking "" "" ""; check auto ;;
    install) install_latest ;;
    request)
      local action
      action="$(cat "$REQUEST" 2>/dev/null || true)"
      rm -f "$REQUEST"
      case "$action" in
        install) install_latest ;;
        install-now) FORCE=1 install_latest ;;
        *) write_status checking "" "" ""; check manual ;;
      esac
      ;;
    status)
      find_latest || true
      echo "geïnstalleerd: $(installed_version)"
      echo "nieuwste:      ${LATEST:-onbekend}"
      ;;
    *) echo "gebruik: kijkbox-update check|install|status"; exit 2 ;;
  esac
}

main "$@"
